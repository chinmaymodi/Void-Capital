# Void Capital -- environment variable template
# Copy to .env and fill in values. docker-compose.yml reads these.
# Docker runs ONLY postgres + redis. The API and python worker run
# directly on the host (see start-api.bat).

# PostgreSQL
POSTGRES_USER=vc_user
POSTGRES_PASSWORD=vc_pass
POSTGRES_DB=void_capital

# Ports (host side)
POSTGRES_PORT=5432
REDIS_PORT=6379
